{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}
    {{ 'three_brs_sylius_404_log_plugin.ui.details'|trans }} - {{ domain }}{{ slug }}
    {{ parent() }}
{% endblock %}

{% block body %}

    {% set prefixes = [
        'three_brs_sylius_404_log_plugin.aggregated_log.details',
        'sylius_admin.common.show'
    ] %}

    {% hook prefixes with {
        domain: domain,
        slug: slug,
        stats: stats,
        logs: logs,
        chartData: chartData,
    } %}

{% endblock body %}