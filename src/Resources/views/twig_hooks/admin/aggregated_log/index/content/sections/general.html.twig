{% from "@SyliusAdmin/shared/helper/accordion.html.twig" import accordion %}
{% import "@SyliusAdmin/shared/helper/button.html.twig" as button %}

{% set aggregatedData = hookable_metadata.context.aggregatedData %}
{% set pagination = hookable_metadata.context.pagination %}
{% set filters = hookable_metadata.context.filters %}

{% set are_filters_set = filters.domain or filters.urlPath or filters.minCount or filters.maxCount %}
{% set path = path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index') %}

<div class="position-relative z-1 bg-white mb-5">
    {% set filter_content %}
        <div class="mb-3">
            <form method="get" action="{{ path }}" novalidate>
                <div class="sylius-filters">
                    <div class="sylius-filters__item">
                        <div class="mb-3 field">
                            <label class="form-label" for="filter_domain">{{ 'three_brs_sylius_404_log_plugin.ui.url_domain'|trans }}</label>
                            <input type="text" id="filter_domain" name="domain" value="{{ filters.domain }}" placeholder="{{ 'three_brs_sylius_404_log_plugin.ui.filter_by_domain'|trans }}" class="form-control">
                        </div>
                    </div>
                    <div class="sylius-filters__item">
                        <div class="mb-3 field">
                            <label class="form-label" for="filter_urlPath">{{ 'three_brs_sylius_404_log_plugin.ui.url_slug'|trans }}</label>
                            <input type="text" id="filter_urlPath" name="urlPath" value="{{ filters.urlPath }}" placeholder="{{ 'three_brs_sylius_404_log_plugin.ui.filter_by_url_path'|trans }}" class="form-control">
                        </div>
                    </div>
                    <div class="sylius-filters__item">
                        <div class="mb-3 field">
                            <label class="form-label" for="filter_minCount">{{ 'three_brs_sylius_404_log_plugin.ui.min_count'|trans }}</label>
                            <input type="number" id="filter_minCount" name="minCount" value="{{ filters.minCount }}" placeholder="{{ 'three_brs_sylius_404_log_plugin.ui.min_occurrences'|trans }}" min="1" class="form-control">
                        </div>
                    </div>
                    <div class="sylius-filters__item">
                        <div class="mb-3 field">
                            <label class="form-label" for="filter_maxCount">{{ 'three_brs_sylius_404_log_plugin.ui.max_count'|trans }}</label>
                            <input type="number" id="filter_maxCount" name="maxCount" value="{{ filters.maxCount }}" placeholder="{{ 'three_brs_sylius_404_log_plugin.ui.max_occurrences'|trans }}" min="1" class="form-control">
                        </div>
                    </div>
                </div>
                <div>
                    {{ button.primary({ text: 'sylius.ui.filter'|trans, icon: 'tabler:adjustments', type: 'submit' }) }}
                    {{ button.default({ text: 'sylius.ui.reset'|trans, url: path }) }}
                </div>
            </form>
        </div>
    {% endset %}

    {{ accordion([{
        title: 'sylius.ui.filters'|trans,
        content: filter_content,
        icon: 'tabler:adjustments',
    }], are_filters_set) }}
</div>

{% if filters.domain or filters.urlPath or filters.minCount or filters.maxCount %}
    <div class="alert alert-info">
        <h5 class="alert-heading">{{ 'three_brs_sylius_404_log_plugin.ui.filtered_results'|trans }}</h5>
        <ul class="mb-0">
            {% if filters.domain %}
                <li>{{ 'three_brs_sylius_404_log_plugin.ui.url_domain'|trans }}: <strong>{{ filters.domain }}</strong></li>
            {% endif %}
            {% if filters.urlPath %}
                <li>{{ 'three_brs_sylius_404_log_plugin.ui.url_slug'|trans }}: <strong>{{ filters.urlPath }}</strong></li>
            {% endif %}
            {% if filters.minCount %}
                <li>{{ 'three_brs_sylius_404_log_plugin.ui.min_count'|trans }}: <strong>{{ filters.minCount }}</strong></li>
            {% endif %}
            {% if filters.maxCount %}
                <li>{{ 'three_brs_sylius_404_log_plugin.ui.max_count'|trans }}: <strong>{{ filters.maxCount }}</strong></li>
            {% endif %}
        </ul>
    </div>
{% endif %}

{% if aggregatedData|length > 0 %}
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle" {{ sylius_test_html_attribute('aggregated-table') }}>
            <thead>
                <tr>
                    <th>{{ 'three_brs_sylius_404_log_plugin.ui.url_domain'|trans }}</th>
                    <th>{{ 'three_brs_sylius_404_log_plugin.ui.url_slug'|trans }}</th>
                    <th class="text-center">{{ 'three_brs_sylius_404_log_plugin.ui.count'|trans }}</th>
                    <th>{{ 'three_brs_sylius_404_log_plugin.ui.last_occurrence'|trans }}</th>
                    <th class="text-center">{{ 'sylius.ui.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in aggregatedData %}
                    <tr>
                        <td><strong>{{ item.urlDomain }}</strong></td>
                        <td>
                            <span class="badge bg-secondary" title="{{ item.urlSlug }}">
                                {% if item.urlSlug|length > 50 %}
                                    {{ item.urlSlug|slice(0, 50) }}...
                                {% else %}
                                    {{ item.urlSlug }}
                                {% endif %}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill {{ item.logCount > 10 ? 'bg-danger' : (item.logCount > 5 ? 'bg-warning text-dark' : 'bg-primary') }}">
                                {{ item.logCount }}
                            </span>
                        </td>
                        <td>{{ item.lastOccurrence|date('d.m.Y H:i:s') }}</td>
                        <td class="text-center">
                            <a href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_details', {
                                'domain': item.urlDomain,
                                'slug': item.urlSlug
                            }) }}" class="btn btn-outline-primary btn-sm me-1">
                                <i class="bi bi-eye"></i>
                                {{ 'three_brs_sylius_404_log_plugin.ui.show_details'|trans }}
                            </a>
                            {% if is_setono_redirect_plugin_installed() %}
                                <a href="{{ path('setono_sylius_redirect_admin_redirect_create') }}" class="btn btn-success btn-sm me-1" onclick="localStorage.setItem('prefill_source', '{{ item.urlSlug|e('js') }}'); localStorage.setItem('prefill_domain', '{{ item.urlDomain|e('js') }}');">
                                    <i class="bi bi-plus"></i>
                                    {{ 'three_brs_sylius_404_log_plugin.ui.create_redirect_for_path'|trans }}
                                </a>
                            {% endif %}
                            <a href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_delete_all', {
                                'domain': item.urlDomain,
                                'slug': item.urlSlug
                            }) }}" class="btn btn-outline-danger btn-sm" onclick="return confirm('{{ 'three_brs_sylius_404_log_plugin.ui.confirm_deletion'|trans }}')">
                                <i class="bi bi-trash"></i>
                                {{ 'three_brs_sylius_404_log_plugin.ui.delete_all_logs'|trans }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    {% if pagination.totalPages > 1 %}
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end">
                {% if pagination.hasPreviousPage %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': 1})) }}" aria-label="First">
                            <span aria-hidden="true">&laquo;&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': pagination.currentPage - 1})) }}" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                {% else %}
                    <li class="page-item disabled"><span class="page-link">&laquo;&laquo;</span></li>
                    <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                {% endif %}

                {% set startPage = max(1, pagination.currentPage - 2) %}
                {% set endPage = min(pagination.totalPages, pagination.currentPage + 2) %}

                {% if startPage > 1 %}
                    <li class="page-item"><a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': 1})) }}">1</a></li>
                    {% if startPage > 2 %}
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    {% endif %}
                {% endif %}

                {% for page in startPage..endPage %}
                    {% if page == pagination.currentPage %}
                        <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                    {% else %}
                        <li class="page-item"><a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': page})) }}">{{ page }}</a></li>
                    {% endif %}
                {% endfor %}

                {% if endPage < pagination.totalPages %}
                    {% if endPage < pagination.totalPages - 1 %}
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    {% endif %}
                    <li class="page-item"><a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': pagination.totalPages})) }}">{{ pagination.totalPages }}</a></li>
                {% endif %}

                {% if pagination.hasNextPage %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': pagination.currentPage + 1})) }}" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="{{ path('three_brs_sylius_404_log_plugin_admin_aggregated_log_index', app.request.query.all|merge({'page': pagination.totalPages})) }}" aria-label="Last">
                            <span aria-hidden="true">&raquo;&raquo;</span>
                        </a>
                    </li>
                {% else %}
                    <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
                    <li class="page-item disabled"><span class="page-link">&raquo;&raquo;</span></li>
                {% endif %}
            </ul>
            <div class="mt-2 text-muted">
                {{ 'three_brs_sylius_404_log_plugin.ui.showing'|trans }} {{ (pagination.currentPage - 1) * pagination.limit + 1 }} - {{ min(pagination.currentPage * pagination.limit, pagination.totalItems) }} {{ 'three_brs_sylius_404_log_plugin.ui.of'|trans }} {{ pagination.totalItems }} {{ 'three_brs_sylius_404_log_plugin.ui.items'|trans }}
            </div>
        </nav>
    {% endif %}
{% else %}
    <div class="alert alert-secondary d-flex align-items-center" role="alert">
        <i class="bi bi-inbox me-2"></i>
        <div>
            <div class="fw-bold">
                {% if filters.domain or filters.urlPath or filters.minCount or filters.maxCount %}
                    {{ 'three_brs_sylius_404_log_plugin.ui.no_results_for_filters'|trans }}
                {% else %}
                    {{ 'sylius.ui.no_results_to_display'|trans }}
                {% endif %}
            </div>
            <p class="mb-0">
                {% if filters.domain or filters.urlPath or filters.minCount or filters.maxCount %}
                    {{ 'three_brs_sylius_404_log_plugin.ui.try_different_filters'|trans }}.
                {% else %}
                    {{ 'No 404 logs found'|trans }}.
                {% endif %}
            </p>
        </div>
    </div>
{% endif %}
